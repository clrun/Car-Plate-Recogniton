<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>车型与车牌检测系统</title>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.14.0/dist/tf.min.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: system-ui, -apple-system, sans-serif;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background: #f5f7fa;
        }
        .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 20px;
        }
        .panel {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        }
        .upload-area {
            border: 2px dashed #cbd5e1;
            border-radius: 8px;
            padding: 40px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            margin-bottom: 15px;
        }
        .upload-area:hover { border-color: #3b82f6; background: #f0f7ff; }
        #fileInput { display: none; }
        .canvas-wrapper {
            position: relative;
            width: 100%;
            aspect-ratio: 4/3;
            background: #f1f5f9;
            border-radius: 8px;
            overflow: hidden;
        }
        canvas { width: 100%; height: 100%; object-fit: contain; }
        .btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 8px;
            background: #3b82f6;
            color: white;
            font-size: 16px;
            cursor: pointer;
            margin-top: 15px;
            transition: background 0.3s;
        }
        .btn:disabled { background: #94a3b8; cursor: not-allowed; }
        .btn:hover:not(:disabled) { background: #2563eb; }
        .result-list {
            margin-top: 15px;
            max-height: 400px;
            overflow-y: auto;
        }
        .result-item {
            padding: 10px;
            border-bottom: 1px solid #f1f5f9;
        }
        .result-item:last-child { border-bottom: none; }
        .label { font-weight: 600; color: #1e293b; }
        .conf { color: #64748b; font-size: 14px; }
        .status {
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 14px;
            margin-bottom: 10px;
        }
        .status.loading { background: #fef3c7; color: #92400e; }
        .status.success { background: #dcfce7; color: #166534; }
    </style>
</head>
<body>
    <h2>车型与车牌检测系统（前端本地推理）</h2>
    
    <div class="container">
        <!-- 左侧：图片上传与预览 -->
        <div class="panel">
            <div id="status" class="status loading">模型加载中，请稍候...</div>
            
            <div class="upload-area" onclick="document.getElementById('fileInput').click()">
                <p>点击上传图片</p>
                <p style="font-size:12px; color:#94a3b8; margin-top:8px">支持 JPG/PNG 格式</p>
            </div>
            <input type="file" id="fileInput" accept="image/*">
            
            <div class="canvas-wrapper">
                <canvas id="outputCanvas"></canvas>
            </div>
            
            <button id="detectBtn" class="btn" disabled>开始检测</button>
        </div>

        <!-- 右侧：检测结果 -->
        <div class="panel">
            <h3>检测结果</h3>
            <div id="resultList" class="result-list">
                <p style="color:#94a3b8; text-align:center; padding:40px 0">等待检测...</p>
            </div>
        </div>
    </div>

    <script>
        // ========== 配置项：根据你的模型修改 ==========
        const CONFIG = {
            // 车型检测模型（YOLOv8 导出的 TFJS 模型）
            vehicleModelPath: './models/vehicle_model/model.json',
            // 车牌检测模型（YOLOv8 导出的 TFJS 模型）
            plateModelPath: './models/plate_model/model.json',
            // 模型输入尺寸
            inputSize: 640,
            // 车型类别（与训练时一致）
            vehicleClasses: ['轿车', 'SUV', '面包车', '货车', '客车', '卡车'],
            // 车牌类别
            plateClasses: ['蓝牌', '绿牌', '黄牌'],
            // 置信度阈值
            confThreshold: 0.5,
            // NMS 阈值
            iouThreshold: 0.45
        };

        let vehicleModel = null;
        let plateModel = null;
        let currentImage = null;
        const canvas = document.getElementById('outputCanvas');
        const ctx = canvas.getContext('2d');

        // 初始化：加载模型
        async function init() {
            try {
                // 加载车型检测模型
                vehicleModel = await tf.loadGraphModel(CONFIG.vehicleModelPath);
                // 加载车牌检测模型
                plateModel = await tf.loadGraphModel(CONFIG.plateModelPath);
                
                updateStatus('模型加载完成，可以上传图片检测', 'success');
                document.getElementById('detectBtn').disabled = false;
            } catch (err) {
                updateStatus('模型加载失败：' + err.message, 'loading');
                console.error(err);
            }
        }

        // 更新状态提示
        function updateStatus(text, type) {
            const statusEl = document.getElementById('status');
            statusEl.textContent = text;
            statusEl.className = `status ${type}`;
        }

        // 图片上传处理
        document.getElementById('fileInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(event) {
                const img = new Image();
                img.onload = function() {
                    currentImage = img;
                    // 调整画布尺寸
                    canvas.width = img.width;
                    canvas.height = img.height;
                    ctx.drawImage(img, 0, 0);
                };
                img.src = event.target.result;
            };
            reader.readAsDataURL(file);
        });

        // 图片预处理：调整尺寸、归一化
        function preprocessImage(img) {
            return tf.tidy(() => {
                const tensor = tf.browser.fromPixels(img)
                    .toFloat()
                    .expandDims(0);
                
                // 调整到模型输入尺寸
                const resized = tf.image.resizeBilinear(tensor, [CONFIG.inputSize, CONFIG.inputSize]);
                // 归一化到 0-1
                const normalized = resized.div(255.0);
                // 转换为 NHWC -> NCHW（YOLO 通常为 NCHW，根据导出格式调整）
                return normalized.transpose([0, 3, 1, 2]);
            });
        }

        // 解析 YOLO 输出 + NMS
        async function parseOutput(output, imgWidth, imgHeight, classNames) {
            const results = [];
            const [batch, channels, boxes] = output.shape;
            
            // 转置为 [boxes, channels]
            const transposed = output.transpose([0, 2, 1]).squeeze(0);
            const data = await transposed.array();
            
            const allBoxes = [];
            const allScores = [];
            const allClasses = [];

            for (let i = 0; i < data.length; i++) {
                const row = data[i];
                const x = row[0], y = row[1], w = row[2], h = row[3];
                
                // 计算最大类别置信度
                const scores = row.slice(4);
                const maxScore = Math.max(...scores);
                const classId = scores.indexOf(maxScore);

                if (maxScore > CONFIG.confThreshold) {
                    // xywh 转 xyxy
                    const x1 = (x - w / 2) / CONFIG.inputSize * imgWidth;
                    const y1 = (y - h / 2) / CONFIG.inputSize * imgHeight;
                    const x2 = (x + w / 2) / CONFIG.inputSize * imgWidth;
                    const y2 = (y + h / 2) / CONFIG.inputSize * imgHeight;

                    allBoxes.push([y1, x1, y2, x2]);
                    allScores.push(maxScore);
                    allClasses.push(classId);
                }
            }

            // NMS 非极大值抑制
            if (allBoxes.length > 0) {
                const nmsIndices = await tf.image.nonMaxSuppressionAsync(
                    allBoxes,
                    allScores,
                    50,
                    CONFIG.iouThreshold,
                    CONFIG.confThreshold
                );
                
                const indices = await nmsIndices.array();
                indices.forEach(idx => {
                    const [y1, x1, y2, x2] = allBoxes[idx];
                    results.push({
                        x1, y1, x2, y2,
                        score: allScores[idx],
                        className: classNames[allClasses[idx]]
                    });
                });
            }

            tf.dispose(transposed);
            return results;
        }

        // 绘制检测框
        function drawDetections(detections, color) {
            detections.forEach(item => {
                const { x1, y1, x2, y2, className, score } = item;
                
                // 画框
                ctx.strokeStyle = color;
                ctx.lineWidth = 3;
                ctx.strokeRect(x1, y1, x2 - x1, y2 - y1);
                
                // 画标签背景
                const label = `${className} ${(score * 100).toFixed(1)}%`;
                ctx.font = '14px sans-serif';
                const textWidth = ctx.measureText(label).width;
                ctx.fillStyle = color;
                ctx.fillRect(x1, y1 - 24, textWidth + 10, 24);
                
                // 画标签文字
                ctx.fillStyle = 'white';
                ctx.fillText(label, x1 + 5, y1 - 7);
            });
        }

        // 执行检测
        document.getElementById('detectBtn').addEventListener('click', async function() {
            if (!currentImage) {
                alert('请先上传图片');
                return;
            }

            const btn = document.getElementById('detectBtn');
            btn.disabled = true;
            updateStatus('检测中...', 'loading');

            try {
                // 清空画布并重绘原图
                ctx.drawImage(currentImage, 0, 0);
                const allResults = [];

                // 1. 车型检测
                const vehicleInput = preprocessImage(currentImage);
                const vehicleOutput = vehicleModel.predict(vehicleInput);
                const vehicleResults = await parseOutput(
                    vehicleOutput, 
                    currentImage.width, 
                    currentImage.height, 
                    CONFIG.vehicleClasses
                );
                drawDetections(vehicleResults, '#3b82f6');
                allResults.push(...vehicleResults.map(r => ({...r, type: '车型检测'})));

                // 2. 车牌检测
                const plateInput = preprocessImage(currentImage);
                const plateOutput = plateModel.predict(plateInput);
                const plateResults = await parseOutput(
                    plateOutput, 
                    currentImage.width, 
                    currentImage.height, 
                    CONFIG.plateClasses
                );
                drawDetections(plateResults, '#10b981');
                allResults.push(...plateResults.map(r => ({...r, type: '车牌检测'})));

                // 渲染结果列表
                renderResultList(allResults);
                updateStatus(`检测完成，共发现 ${allResults.length} 个目标`, 'success');

                // 释放显存
                tf.dispose([vehicleInput, vehicleOutput, plateInput, plateOutput]);
            } catch (err) {
                alert('检测失败：' + err.message);
                console.error(err);
            } finally {
                btn.disabled = false;
            }
        });

        // 渲染结果列表
        function renderResultList(results) {
            const listEl = document.getElementById('resultList');
            if (results.length === 0) {
                listEl.innerHTML = '<p style="color:#94a3b8; text-align:center; padding:40px 0">未检测到目标</p>';
                return;
            }

            listEl.innerHTML = results.map((item, index) => `
                <div class="result-item">
                    <div class="label">${index + 1}. ${item.type}：${item.className}</div>
                    <div class="conf">置信度：${(item.score * 100).toFixed(2)}%</div>
                </div>
            `).join('');
        }

        // 页面加载完成后初始化
        window.onload = init;
    </script>
</body>
</html>
